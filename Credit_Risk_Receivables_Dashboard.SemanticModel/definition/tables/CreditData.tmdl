			    "Last Sale Date", DATETIME,
			    "Total Payment", INTEGER,
			    "Payment Month", STRING,
			    "Last Payment Date", DATETIME,
			    "DUE", INTEGER,
			    "Sales Frequency", INTEGER,
			    "Payment Freqency", INTEGER,
			    "Balance_status", STRING,
