table CreditData

	column 'Client Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Client Name

	column 'Address'
		dataType: string
		summarizeBy: none
		sourceColumn: Address

	column 'Team'
		dataType: string
		summarizeBy: none
		sourceColumn: Team

	column 'Total Sale'
		dataType: int64
		summarizeBy: sum
		sourceColumn: Total Sale

	column 'Sale Month'
		dataType: string
		summarizeBy: none
		sourceColumn: Sale Month

	column 'Last Sale Date'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Last Sale Date

	column 'Total Payment'
		dataType: int64
		summarizeBy: sum
		sourceColumn: Total Payment

	column 'Payment Month'
		dataType: string
		summarizeBy: none
		sourceColumn: Payment Month

	column 'Last Payment Date'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Last Payment Date

	column 'DUE'
		dataType: int64
		summarizeBy: sum
		sourceColumn: DUE

	column 'Sales Frequency'
		dataType: int64
		summarizeBy: sum
		sourceColumn: Sales Frequency

	column 'Payment Freqency'
		dataType: int64
		summarizeBy: sum
		sourceColumn: Payment Freqency

	column 'Balance_status'
		dataType: string
		summarizeBy: none
		sourceColumn: Balance_status

	column 'Credit Risk'
		dataType: string
		summarizeBy: none
		sourceColumn: Credit Risk

	column 'Days Since Last Collection'
		dataType: int64
		summarizeBy: average
		sourceColumn: Days Since Last Collection

	column 'Recency Status'
		dataType: string
		summarizeBy: none
		sourceColumn: Recency Status

	measure 'Total Sales' = SUM(CreditData[Total Sale])
		formatString: ₹#,##0

	measure 'Total Payments' = SUM(CreditData[Total Payment])
		formatString: ₹#,##0

	measure 'Total Due' = SUM(CreditData[DUE])
		formatString: ₹#,##0

	measure 'Critical Clients' = CALCULATE(COUNTROWS(CreditData), CreditData[Credit Risk] = "Critical")
		formatString: #,##0

	measure 'Collection Efficiency' = DIVIDE([Total Payments], [Total Sales])
		formatString: 0%

	measure 'Total Clients' = DISTINCTCOUNT(CreditData[Client Name])
		formatString: #,##0

	measure 'Average Due' = AVERAGE(CreditData[DUE])
		formatString: ₹#,##0

	measure 'Total Sales Cr' = DIVIDE([Total Sales], 10000000)
		formatString: ₹0.00 "Cr"

	measure 'Total Payments Cr' = DIVIDE([Total Payments], 10000000)
		formatString: ₹0.00 "Cr"

	measure 'Total Due L' = DIVIDE([Total Due], 100000)
		formatString: ₹0.00 "L"

	measure 'Risk Client Count' = DISTINCTCOUNT(CreditData[Client Name])
		formatString: #,##0

	measure 'Recency Client Count' = DISTINCTCOUNT(CreditData[Client Name])
		formatString: #,##0

	measure 'Top 10 Due' =
		VAR CurrentClient = SELECTEDVALUE(CreditData[Client Name])
		VAR ClientRank = RANKX(ALLSELECTED(CreditData[Client Name]), [Total Due], , DESC, DENSE)
		RETURN IF(NOT ISBLANK(CurrentClient) && ClientRank <= 10, [Total Due])
		formatString: ₹#,##0

	measure 'Total Sales by Sale Date' = CALCULATE([Total Sales], USERELATIONSHIP(CreditData[Last Sale Date], DateTable[Date]))
		formatString: ₹#,##0

	measure 'Total Payments by Payment Date' = CALCULATE([Total Payments], USERELATIONSHIP(CreditData[Last Payment Date], DateTable[Date]))
		formatString: ₹#,##0

	measure 'Risk Exposure' = [Total Due]
		formatString: ₹#,##0

	column 'Collection Ageing Bucket' =
		SWITCH(TRUE(),
			CreditData[Days Since Last Collection] <= 30, "0-30 days",
			CreditData[Days Since Last Collection] <= 60, "31-60 days",
			CreditData[Days Since Last Collection] <= 90, "61-90 days",
			"90+ days"
		)
		dataType: string
		summarizeBy: none

	partition CreditData = calculated
		mode: import
		source =
			DATATABLE(
			    "Client Name", STRING,
			    "Address", STRING,
			    "Team", STRING,
			    "Total Sale", INTEGER,
