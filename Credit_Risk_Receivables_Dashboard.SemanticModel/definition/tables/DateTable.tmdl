table DateTable
	dataCategory: Time

	column Date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

	column 'Month Number'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Month Number

	column 'Month Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Month Name
		sortByColumn: 'Month Number'

	column 'Year Month'
		dataType: string
		summarizeBy: none
		sourceColumn: Year Month

	partition DateTable = calculated
		mode: import
		source = ADDCOLUMNS(CALENDAR(DATE(2025,11,1), DATE(2026,1,31)), "Year", YEAR([Date]), "Month Number", MONTH([Date]), "Month Name", FORMAT([Date], "MMM"), "Year Month", FORMAT([Date], "YYYY-MM"))
